# 必填:Gemini API key(https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 選填:要用的模型;整行拿掉則用程式預設 gemini-3-flash-preview(util/config.py DEFAULT_GEMINI_MODEL)
GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDER=gemini

# 選填:log 送進 prompt 的方式
#   inline(預設)    = log 純文字內嵌進 prompt
#   attachment      = log 當成附件檔(inline_data)送給模型,貼近 AI Studio 夾檔
LOG_INPUT_MODE=inline

# 選填:印出 SQLAlchemy 的 SQL log(dev debug 用),預設 false
SQL_ECHO=false

# 選填:SQLite 檔路徑,預設 data/novel.db;相對路徑以 repo 根目錄為基準
#   例:DB_PATH=data/novel_demo.db(只有 sample 資料的 demo DB)
# DB_PATH=data/novel.db
